// File version shown in the DLL's Properties > Details. The numbers come from cvon_version.h.
#include <winres.h>
#include "cvon_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CVON_VERSION_MAJOR, CVON_VERSION_MINOR, CVON_VERSION_PATCH, 0
 PRODUCTVERSION CVON_VERSION_MAJOR, CVON_VERSION_MINOR, CVON_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Coalition TeamSpeak Plugin"
            VALUE "FileVersion", CVON_VERSION_STRING
            VALUE "InternalName", "CRF_Teamspeak_Plugin_Main"
            VALUE "OriginalFilename", "CRF_Teamspeak_Plugin_Main.dll"
            VALUE "ProductName", "Coalition TeamSpeak Plugin"
            VALUE "ProductVersion", CVON_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
